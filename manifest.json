{
  "id": "robot_vacuum_cleaner",
  "name": "Robot Vacuum (Roborock)",
  "version": "2.1.0",
  "description": "Saros 20 status with configurable time-of-day refresh intervals and usage tracking.",
  "author": "peterdgreenway",
  "repository": "https://github.com/peterdgreenway/robot-vacuum-cleaner",
  "documentation": "README.md",
  "icon": "robot",
  "category": "home",
  "min_refresh_seconds": 30,
  "settings_schema": {
    "type": "object",
    "properties": {
      "service_url": {
        "type": "string",
        "title": "Roborock service URL",
        "default": "http://192.168.100.99:8088",
        "description": "LAN URL of the separate Roborock service container"
      },
      "night_start": {
        "type": "string",
        "title": "Night patrol start (24-hour)",
        "default": "03:00"
      },
      "night_end": {
        "type": "string",
        "title": "Night patrol end (24-hour)",
        "default": "04:00"
      },
      "night_interval_seconds": {
        "type": "integer",
        "title": "Night patrol refresh interval (seconds)",
        "default": 900,
        "minimum": 30,
        "maximum": 86400
      },
      "peak_start": {
        "type": "string",
        "title": "Peak activity start (24-hour)",
        "default": "07:30"
      },
      "peak_end": {
        "type": "string",
        "title": "Peak activity end (24-hour)",
        "default": "10:30"
      },
      "peak_interval_seconds": {
        "type": "integer",
        "title": "Peak activity refresh interval (seconds)",
        "default": 600,
        "minimum": 30,
        "maximum": 86400
      },
      "default_interval_seconds": {
        "type": "integer",
        "title": "All other times refresh interval (seconds)",
        "default": 3600,
        "minimum": 30,
        "maximum": 86400
      },
      "daily_operation_limit": {
        "type": "integer",
        "title": "Daily tracked-operation safety limit",
        "default": 1000,
        "minimum": 1,
        "maximum": 100000
      }
    },
    "required": [
      "service_url"
    ]
  },
  "variables": {
    "simple": [
      "line1",
      "line2",
      "line3",
      "name",
      "battery_level",
      "battery",
      "is_charging",
      "is_docked",
      "dock_state",
      "robot_state",
      "activity",
      "cleaning_activity",
      "current_room",
      "room",
      "cleaning_mode",
      "cleaning_progress",
      "cleaning_time_minutes",
      "area_cleaned_m2",
      "do_not_disturb",
      "map_present",
      "error",
      "has_error",
      "last_refresh",
      "night_start",
      "night_end",
      "night_interval_seconds",
      "peak_start",
      "peak_end",
      "peak_interval_seconds",
      "default_interval_seconds",
      "tracked_operations_today",
      "daily_operation_limit",
      "api_usage_percent",
      "operations_remaining",
      "next_refresh"
    ]
  },
  "max_lengths": {
    "line1": 15,
    "line2": 15,
    "line3": 15
  },
  "teaser": "SAROS 20 ROBOT",
  "previews": [
    {
      "device_type": "note",
      "rows": [
        "SAROS 20 - 34%",
        "VACUUMING",
        "KITCHEN"
      ]
    }
  ],
  "fiestaboard_version": ">=9.0.0"
}
