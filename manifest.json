{
  "id": "robot_vacuum_cleaner",
  "name": "Robot Vacuum (Roborock)",
  "version": "1.3.2",
  "description": "Compact Roborock status for Vestaboard Note (3x15) with room support",
  "author": "peterdgreenway",
  "repository": "https://github.com/peterdgreenway/fiestaboard-plugin--robot-vacuum",
  "documentation": "README.md",
  "icon": "robot",
  "category": "home",
  "min_refresh_seconds": 60,
  "settings_schema": {
    "type": "object",
    "properties": {
      "email": {
        "type": "string",
        "title": "Roborock email",
        "description": "Account email used with the Roborock app"
      },
      "user_data_json": {
        "type": "string",
        "title": "UserData JSON",
        "description": "One-time UserData token (see docs/SETUP.md)",
        "ui:widget": "textarea"
      },
      "device_name": {
        "type": "string",
        "title": "Device name filter",
        "description": "Optional – leave blank for first vacuum"
      },
      "refresh_seconds": {
        "type": "integer",
        "title": "Refresh (seconds)",
        "default": 120,
        "minimum": 60,
        "maximum": 900
      }
    },
    "required": ["email", "user_data_json"]
  },
  "variables": {
    "simple": [
      "line1",
      "line2",
      "line3",
      "name",
      "activity",
      "battery",
      "status",
      "room",
      "area_time",
      "error"
    ]
  },
  "max_lengths": {
    "line1": 15,
    "line2": 15,
    "line3": 15,
    "name": 15,
    "activity": 15,
    "battery": 4,
    "status": 15,
    "room": 15,
    "area_time": 15,
    "error": 15
  },
  "teaser": "CLEAN  87%",
  "previews": [
    {
      "device_type": "note",
      "rows": [
        "SAROS 20",
        "CLEAN  87%",
        "KITCHEN"
      ]
    }
  ],
  "fiestaboard_version": ">=9.0.0"
}
