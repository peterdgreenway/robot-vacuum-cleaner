{
  "id": "robot_vacuum",
  "name": "Robot Vacuum (Roborock)",
  "version": "1.1.0",
  "description": "Live status, battery, fan speed, clean stats and consumables from a Roborock vacuum using the official cloud API",
  "author": "peterdgreenway",
  "repository": "https://github.com/peterdgreenway/fiestaboard-plugin--robot-vacuum",
  "documentation": "README.md",
  "icon": "robot",
  "category": "home",
  "min_refresh_seconds": 60,
  "settings_schema": {
    "type": "object",
    "properties": {
      "email": {
        "type": "string",
        "title": "Roborock account email",
        "description": "The email address registered with the Roborock app"
      },
      "user_data_json": {
        "type": "string",
        "title": "UserData JSON (one-time)",
        "description": "Paste the full UserData object obtained after the email code login (see docs/SETUP.md). Keep this secret.",
        "ui:widget": "textarea"
      },
      "device_name": {
        "type": "string",
        "title": "Device name filter (optional)",
        "description": "Leave blank to use the first vacuum. Match the name shown in the Roborock app."
      },
      "refresh_seconds": {
        "type": "integer",
        "title": "Refresh interval (seconds)",
        "default": 120,
        "minimum": 60,
        "maximum": 900
      }
    },
    "required": ["email", "user_data_json"]
  },
  "variables": {
    "simple": [
      "name", "status", "activity", "battery", "battery_icon",
      "fan_speed", "clean_time", "clean_area", "error",
      "docked", "charging", "cleaning", "mop_attached",
      "main_brush", "side_brush", "filter", "sensor",
      "formatted", "last_updated"
    ]
  },
  "max_lengths": {
    "name": 15,
    "status": 15,
    "activity": 12,
    "battery": 4,
    "fan_speed": 10,
    "clean_time": 8,
    "clean_area": 8,
    "error": 15,
    "formatted": 15
  },
  "teaser": "VACUUM  87% CLEAN",
  "previews": [
    {
      "device_type": "note",
      "rows": [
        "ROBOROCK S8",
        "{66}CLEANING  87%",
        "AREA 42m  28min"
      ]
    },
    {
      "device_type": "flagship",
      "rows": [
        "     ROBOT VACUUM",
        "ROBOROCK S8 MAXV",
        "{66}STATUS  CLEANING",
        "BATTERY 87%  FAN MAX",
        "CLEAN 42 m2  28 min",
        "BRUSH 82%  FILTER 91%"
      ]
    }
  ],
  "fiestaboard_version": ">=9.0.0"
}
